{
  "name": "ledger-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Double-entry ledger core: idempotent transfers, database-enforced invariants, transactional outbox.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/db/migrate-cli.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify:ledger": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-ledger.mjs",
    "neon:deploy": "neon deploy"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
