# Application traffic (pooled) - copy from `neon env pull`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger

# Schema migrations (direct / unpooled). On Neon this is the host without `-pooler`.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/ledger

# Injected by `neon env pull`
NEON_BRANCH=production

# Local pool size per process (Neon's pooler multiplexes beyond this)
PG_POOL_MAX=10
PORT=3000

# Optional: run integration tests against a real Postgres instead of PGlite.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger_test
